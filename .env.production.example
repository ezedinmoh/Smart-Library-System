# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env in production and fill in all values
# NEVER commit .env file to version control!

# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================

# CRITICAL: Generate a new secret key for production
# Run this command to generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-production-key-here-change-this

# Debug mode - MUST be False in production
DEBUG=False

# Allowed hosts - comma-separated list of your domains
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================================
# DATABASE - POSTGRESQL
# ============================================================================

# PostgreSQL database configuration
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=your-secure-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Alternative: Use DATABASE_URL (for Heroku, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# REDIS - CELERY BROKER
# ============================================================================

# Redis URL for Celery broker and result backend
# Local: redis://localhost:6379/0
# Remote: redis://username:password@host:port/0
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP (recommended for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Your Gmail credentials
# IMPORTANT: Use App Password, not your regular Gmail password
# Get App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here

# From email addresses
DEFAULT_FROM_EMAIL=Smart Library <your-email@gmail.com>
SERVER_EMAIL=your-email@gmail.com

# Admin email for error notifications
ADMIN_EMAIL=admin@yourdomain.com

# ============================================================================
# SITE CONFIGURATION
# ============================================================================

# Site name and URL
SITE_NAME=Smart Library Management System
SITE_URL=https://yourdomain.com

# ============================================================================
# PAYMENT GATEWAYS - PRODUCTION KEYS
# ============================================================================

# Stripe (International Payments)
# Get PRODUCTION keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Chapa (Ethiopian Payments)
# Get PRODUCTION keys from: https://dashboard.chapa.co/
CHAPA_SECRET_KEY=CHASECK_LIVE-your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
# Example: https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================

# Celery task execution mode
# False = Asynchronous (production)
# True = Synchronous (development/testing)
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================================================

# 1. Generate SECRET_KEY:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# 2. Install PostgreSQL:
#    - Ubuntu: sudo apt install postgresql postgresql-contrib
#    - Create database: sudo -u postgres createdb library_db
#    - Create user: sudo -u postgres createuser library_user
#    - Set password: sudo -u postgres psql -c "ALTER USER library_user PASSWORD 'your-password';"

# 3. Install Redis:
#    - Ubuntu: sudo apt install redis-server
#    - Start: sudo systemctl start redis
#    - Enable: sudo systemctl enable redis

# 4. Install Python packages:
#    pip install psycopg2-binary whitenoise redis

# 5. Collect static files:
#    python manage.py collectstatic --settings=library_system.settings_production

# 6. Run migrations:
#    python manage.py migrate --settings=library_system.settings_production

# 7. Create superuser:
#    python manage.py createsuperuser --settings=library_system.settings_production

# 8. Start Celery worker:
#    celery -A library_system worker -l info

# 9. Start Celery beat:
#    celery -A library_system beat -l info

# 10. Run security check:
#     python manage.py check --deploy --settings=library_system.settings_production
