# ============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================================================
# This file is for DEVELOPMENT only. For production, use .env.production.example

# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Generate a new SECRET_KEY for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Email Configuration (Gmail SMTP)
# Follow these steps to get your Gmail App Password:
# 1. Go to https://myaccount.google.com/
# 2. Navigate to Security → 2-Step Verification (enable if not enabled)
# 3. Scroll down to App passwords
# 4. Generate a new app password for "Mail" → "Other (Custom name)"
# 5. Copy the 16-character password and paste below

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=Smart Library <your-email@gmail.com>
SERVER_EMAIL=your-email@gmail.com

# Site Configuration
SITE_NAME=Smart Library Management System
SITE_URL=http://localhost:8000

# Payment Gateway Configuration

# Stripe (International Payments)
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Chapa (Ethiopian Payments)
# Get your keys from: https://dashboard.chapa.co/
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# ============================================================================
# OPTIONAL: REDIS & CELERY (For Background Tasks)
# ============================================================================
# For development, Celery runs in "eager" mode (synchronous)
# For production, install Redis and set REDIS_URL

# Redis URL (optional for development)
# Local: redis://localhost:6379/0
# Leave empty to use in-memory broker (development only)
REDIS_URL=

# Celery task execution mode
# True = Synchronous (development) - tasks run immediately
# False = Asynchronous (production) - tasks run in background
CELERY_TASK_ALWAYS_EAGER=True

# ============================================================================
# OPTIONAL: DATABASE (PostgreSQL for Production)
# ============================================================================
# Development uses SQLite by default (no configuration needed)
# For production, use PostgreSQL:

# DATABASE_URL=postgresql://user:password@localhost:5432/library_db
# Or configure individually:
# DB_NAME=library_db
# DB_USER=library_user
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================================
# OPTIONAL: CORS ORIGINS
# ============================================================================
# Comma-separated list of allowed origins for API access
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
